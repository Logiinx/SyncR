{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SyncR",
  "version": "../package.json",
  "identifier": "com.logiinx.syncr",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SyncR",
        "width": 1100,
        "height": 750,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "useHttpsScheme": true,
        "dragDropEnabled": false,
        "backgroundColor": "#161616"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFNDY4NzVCRTg2NkE3NDMKUldSRHAyYm9XNGRHUGhYT2NqWGlnNCs2ZTMyM1p6T3ZkR2VlNWFCR2d5R0dhSEpzUWZVMEVTeUMK",
      "endpoints": [
        "https://github.com/Logiinx/SyncR/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
